# Copy this file to .env and replace the placeholder with your current Riot key.
RIOT_API_KEY=RGAPI-your-development-key

# Provision Neon through the Vercel Marketplace. Use pooled traffic for the app
# and the direct connection only for migrations.
DATABASE_URL=postgresql://user:password@pooler-host/database?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@direct-host/database?sslmode=require
